# Copia este archivo como .env y completa los valores. El .env nunca se sube a Git.

# --- Base de datos (MySQL) ---
MYSQL_DATABASE=mediflow
DB_USER=mediflow
DB_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
# Nombre del volumen de Docker con los datos (para reutilizar una base existente)
MYSQL_VOLUME=mediflow-mysql-data

# --- Seguridad (Spring Boot) ---
# Mínimo 32 caracteres aleatorios. Genera uno con:  openssl rand -base64 48
JWT_SECRET=
# Administrador inicial: se crea al arrancar si no existe (luego puedes borrar estas dos líneas)
MEDIFLOW_ADMIN_USER=admin
MEDIFLOW_ADMIN_PASSWORD=

# --- IA (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- OCI Object Storage (opcional) ---
# Carpeta con el archivo "config" de OCI y la clave privada. Si no la defines, se omite OCI.
# OCI_CONFIG_DIR=C:/mediflow-oci-docker
OCI_PROFILE=DEFAULT

# --- Alertas en tiempo real (opcional) ---
# Webhook de Slack, Discord o n8n para avisar los casos urgentes.
ALERTA_WEBHOOK_URL=
# true = el aviso incluye el nombre del paciente (solo si el webhook es interno)
ALERTA_INCLUIR_PACIENTE=false

# --- Puertos en tu máquina ---
FRONTEND_PORT=3000
BACKEND_PORT=8088
FASTAPI_PORT=8002
MYSQL_PORT=3306
